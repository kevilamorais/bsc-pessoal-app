{
  "name": "bsc-pessoal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Planejamento BSC pessoal com Cloudflare Workers e D1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "db:local": "wrangler d1 execute bsc-pessoal --local --file=./migrations/0001_initial.sql",
    "db:remote": "wrangler d1 execute bsc-pessoal --remote --file=./migrations/0001_initial.sql",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
