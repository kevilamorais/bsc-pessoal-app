{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bsc-pessoal",
  "main": "src/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "dev": { "ip": "127.0.0.1", "port": 8787, "inspector_port": 9230 },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bsc-pessoal",
      "database_id": "5b6ca673-eba4-4ad3-984a-0086751b727a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AUTH_MODE": "demo",
    "DEMO_USER_ID": "demo-publico"
  },
  "observability": { "enabled": true }
}
